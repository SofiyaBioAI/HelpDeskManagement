@model IEnumerable<HelpDesk.Mvc.Models.Ticket>

@{
    ViewData["Title"] = "All Tickets";
}

<h2>All Tickets</h2>

<p>
    <a asp-action="Dashboard" class="btn btn-success">
        Dashboard
    </a>

    <a asp-action="Filter" class="btn btn-warning">
        Filter Tickets
    </a>

    <a asp-action="Create" class="btn btn-primary">
        Raise New Ticket
    </a>
</p>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Raised By</th>
            <th>Created Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
                <td>@item.Priority</td>
                <td>@item.Status</td>
                <td>@item.RaisedBy</td>
                <td>@item.CreatedDate.ToShortDateString()</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }

    </tbody>

</table>