@model IEnumerable<HelpDesk.Mvc.Models.Ticket>

@{
    ViewData["Title"] = "Filter Tickets";
}

<h2>Filter Tickets by Status</h2>

<form asp-action="Filter" method="get">

    <div class="row">

        <div class="col-md-4">

            <select name="status" class="form-select">

                <option value="">Select Status</option>

                <option>Open</option>

                <option>In Progress</option>

                <option>Closed</option>

            </select>

        </div>

        <div class="col-md-2">

            <button type="submit" class="btn btn-primary">
                Search
            </button>

        </div>

    </div>

</form>

<br />

<table class="table table-bordered">

    <thead>

        <tr>

            <th>Id</th>

            <th>Title</th>

            <th>Priority</th>

            <th>Status</th>

            <th>Raised By</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Id</td>

                <td>@item.Title</td>

                <td>@item.Priority</td>

                <td>@item.Status</td>

                <td>@item.RaisedBy</td>

            </tr>
        }

    </tbody>

</table>

<a asp-action="Index" class="btn btn-secondary">
    Back
</a>